<?xml version="1.0"?>
<robot name="golf_trolley" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════
       PROPERTIES
  ═══════════════════════════════════ -->
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.54"/>
  <xacro:property name="base_mass" value="11.35"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="bag_mass" value="9.0"/>

  <!-- ═══════════════════════════════════
       INERTIA MACROS
  ═══════════════════════════════════ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12)*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${(m/12)*(x*x+z*z)}" iyz="0"
               izz="${(m/12)*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12)*(3*r*r+l*l)}" ixy="0" ixz="0"
               iyy="${(m/12)*(3*r*r+l*l)}" iyz="0"
               izz="${(m/2)*(r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0" ixz="0"
               iyy="${(2/5)*m*r*r}" iyz="0"
               izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ═══════════════════════════════════
       MATERIALS
  ═══════════════════════════════════ -->
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1"/>
  </material>
  <material name="dark">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="grey">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <!-- ═══════════════════════════════════
       DUMMY ROOT LINK
  ═══════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════
       BASE LINK
  ═══════════════════════════════════ -->
  <link name="base_link">
    <xacro:box_inertia m="${base_mass}" x="0.2" y="0.5" z="0.2"/>
    <visual>
      <geometry><box size="0.2 0.5 0.2"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.2 0.5 0.2"/></geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ═══════════════════════════════════
       LEFT WHEEL
  ═══════════════════════════════════ -->
  <link name="left_wheel">
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    <visual>
      <origin rpy="1.5707 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 -0.27 -0.05"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>

  <gazebo reference="left_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════
       RIGHT WHEEL
  ═══════════════════════════════════ -->
  <link name="right_wheel">
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    <visual>
      <origin rpy="1.5707 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0"/>
      <geometry><cylinder length="${wheel_width}" radius="${wheel_radius}"/></geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 0.27 -0.05"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2"/>
  </joint>

  <gazebo reference="right_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════
       STEM
  ═══════════════════════════════════ -->
  <link name="stem_link">
    <xacro:box_inertia m="1.0" x="0.7" y="0.12" z="0.02"/>
    <visual>
      <geometry><box size="0.7 0.12 0.02"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.7 0.12 0.02"/></geometry>
    </collision>
  </link>

  <joint name="stem_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stem_link"/>
    <origin xyz="-0.4 0 -0.065" rpy="0 0 0"/>
  </joint>

  <gazebo reference="stem_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ═══════════════════════════════════
       REAR CASTER
  ═══════════════════════════════════ -->
  <link name="caster_rear">
    <xacro:sphere_inertia m="0.5" r="0.03"/>
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="stem_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.35 0 -0.025" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_rear">
    <material>Gazebo/White</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════
       UPRIGHT
  ═══════════════════════════════════ -->
  <link name="upright_link">
    <xacro:box_inertia m="0.8" x="0.02" y="0.02" z="0.55"/>
    <visual>
      <geometry><box size="0.02 0.02 0.55"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.55"/></geometry>
    </collision>
  </link>

  <joint name="upright_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upright_link"/>
    <origin xyz="0.05 0 0.32" rpy="0 0 0"/>
  </joint>

  <gazebo reference="upright_link">
    <material>Gazebo/Grey</material>
  </gazebo> 

  <!-- ═══════════════════════════════════
       HANDLE
  ═══════════════════════════════════ -->
  <link name="handle_link">
    <xacro:box_inertia m="0.7" x="1.022" y="0.02" z="0.02"/>
    <visual>
      <geometry><box size="1.022 0.02 0.02"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="1.022 0.02 0.02"/></geometry>
    </collision>
  </link>

  <joint name="handle_joint" type="fixed">
    <parent link="upright_link"/>
    <child link="handle_link"/>
    <origin xyz="-0.35 0 -0.04" rpy="0 -0.76 0"/>
  </joint>

  <gazebo reference="handle_link">
    <material>Gazebo/Grey</material>
  </gazebo> 

  <!-- ═══════════════════════════════════
       GRIP
  ═══════════════════════════════════ -->
  <link name="grip_link">
    <xacro:box_inertia m="0.2" x="0.02" y="0.32" z="0.02"/>
    <visual>
      <geometry><box size="0.02 0.32 0.02"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.32 0.02"/></geometry>
    </collision>
  </link>

  <joint name="grip_joint" type="fixed">
    <parent link="handle_link"/>
    <child link="grip_link"/>
    <origin xyz="0.45 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="grip_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo> 

  <!-- ═══════════════════════════════════
       LIDAR
  ═══════════════════════════════════ -->
  <link name="lidar_link">
    <xacro:cylinder_inertia m="0.2" r="0.04" l="0.04"/>
    <visual>
      <geometry><cylinder length="0.04" radius="0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder length="0.04" radius="0.04"/></geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.05 0.12 0.15" rpy="0 0.01745 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
    <sensor name="lidar" type="gpu_lidar">
      <update_rate>20</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-${pi/2}</min_angle>
            <max_angle>${pi/2}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

<!-- ═══════════════════════════════════
     RGB-D CAMERA
════════════════════════════════════ -->
<link name="rgbd_camera_link">
  <xacro:box_inertia m="0.2" x="0.025" y="0.09" z="0.025"/>

  <visual>
    <geometry><box size="0.025 0.09 0.025"/></geometry>
    <material name="dark"/>
  </visual>

  <collision>
    <geometry><box size="0.025 0.09 0.025"/></geometry>
  </collision>
</link>

<joint name="rgbd_camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="rgbd_camera_link"/>
  <!-- front camera, slightly tilted down -->
  <origin xyz="0.08 0 0.25" rpy="0 0.2 0"/>
</joint>

<gazebo reference="rgbd_camera_link">
  <material>Gazebo/DarkGrey</material>

  <!-- RGB output -->
  <sensor name="rgbd_rgb_camera" type="camera">
    <update_rate>10</update_rate>
    <topic>/rgbd_camera/image_raw</topic>
    <gz_frame_id>rgbd_camera_link</gz_frame_id>

    <camera>
      <horizontal_fov>1.5184</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>15.0</far>
      </clip>
    </camera>

    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>

  <!-- Depth output -->
  <sensor name="rgbd_depth_camera" type="depth_camera">
    <update_rate>10</update_rate>
    <topic>/rgbd_camera/depth_image</topic>
    <gz_frame_id>rgbd_camera_link</gz_frame_id>

    <camera>
      <horizontal_fov>1.5184</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R_FLOAT32</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>15.0</far>
      </clip>
    </camera>

    <always_on>true</always_on>
    <visualize>false</visualize>
  </sensor>

</gazebo>

  <!-- ═══════════════════════════════════
       IMU
  ═══════════════════════════════════ -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.02"/>
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════
       GOLF BAG PAYLOAD
  ═══════════════════════════════════ -->
  <link name="golf_bag_link">
    <xacro:cylinder_inertia m="${bag_mass}" r="0.09" l="0.8"/>

    <visual>
      <geometry>
        <cylinder length="0.8" radius="0.09"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.8" radius="0.09"/>
      </geometry>
    </collision>
  </link>

  <joint name="golf_bag_joint" type="fixed">
    <parent link="base_link"/>
    <child link="golf_bag_link"/>
    <!-- xyz = bag position, rpy = bag leaning angle -->
    <origin xyz="-0.25 0 0.45" rpy="0 0.55 0"/>
  </joint>

  <gazebo reference="golf_bag_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  
  
    <!-- ═══════════════════════════════════
       SIMULATED GPS / NAVSAT
  ═══════════════════════════════════ -->
  <link name="gps_link">
    <xacro:box_inertia m="0.05" x="0.05" y="0.05" z="0.02"/>

    <visual>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>

    <!-- GPS antenna mounted above the trolley -->
    <origin xyz="0.05 0 0.65" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps_link">
    <material>Gazebo/DarkGrey</material>

    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <topic>/gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>
  
 <!-- ═══════════════════════════════════
     DIFF DRIVE PLUGIN
═══════════════════════════════════ -->
<gazebo>
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">

    <left_joint>right_wheel_joint</left_joint>
    <right_joint>left_wheel_joint</right_joint>

    <wheel_separation>${wheel_separation}</wheel_separation>
    <wheel_radius>${wheel_radius}</wheel_radius>

    <max_linear_acceleration>1.0</max_linear_acceleration>
    <min_linear_acceleration>-1.0</min_linear_acceleration>
    <max_angular_acceleration>2.0</max_angular_acceleration>
    <min_angular_acceleration>-2.0</min_angular_acceleration>

    <topic>/cmd_vel_nav</topic>

    <odom_topic>/odom</odom_topic>
    <tf_topic>/tf</tf_topic>

    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>

    <odom_publish_frequency>20</odom_publish_frequency>

  </plugin>
</gazebo>

  <!-- ═══════════════════════════════════
       JOINT STATE PUBLISHER PLUGIN
  ═══════════════════════════════════ -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
