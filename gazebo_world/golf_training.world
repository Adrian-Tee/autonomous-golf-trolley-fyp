        </collision>

        <visual name="vis">
          <geometry>
            <box>
              <size>10 30 0.06</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>

      </link>

      <!-- End fairway ground -->
      <link name="link_end">
        <pose>0 27.5 0 0 0 0</pose>

        <collision name="col">
          <geometry>
            <box>
              <size>12 5 0.06</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="vis">
          <geometry>
            <box>
              <size>12 5 0.06</size>
            </box>
          </geometry>

          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

